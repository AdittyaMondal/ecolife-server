{
  "name": "ecolife-server",
  "version": "0.1.0",
  "private": true,
  "description": "EcoLife API server — Bun + Hono + Drizzle + PostgreSQL",
  "type": "module",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "bun": ">=1.2.0"
  },
  "scripts": {
    "dev": "bun --watch src/main.ts",
    "start": "bun src/main.ts",
    "build": "tsc --noEmit && bun build src/main.ts --target bun --outdir dist",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "bun test",
    "migration:generate": "bun --bun drizzle-kit generate",
    "migration:apply": "bun src/database/migrate.ts",
    "db:studio": "bun --bun drizzle-kit studio"
  },
  "dependencies": {
    "drizzle-orm": "^0.44.6",
    "hono": "^4.10.3",
    "pg": "^8.16.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.4",
    "@types/bun": "^1.3.2",
    "@types/pg": "^8.15.6",
    "drizzle-kit": "^0.31.6",
    "typescript": "^5.9.3"
  }
}
