{
  "name": "ecolife-server",
  "version": "0.1.0",
  "private": true,
  "description": "EcoLife API server \u2014 Bun + Hono + Drizzle + PostgreSQL",
  "type": "module",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "bun": ">=1.2.0"
  },
  "scripts": {
    "dev": "bun --watch src/main.ts",
    "start": "bun src/main.ts",
    "build": "tsc --noEmit && bun build src/main.ts --target bun --outdir dist",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "bun test",
    "migration:generate": "bun --bun drizzle-kit generate",
    "migration:apply": "bun src/database/migrate.ts",
    "seed": "bun src/database/seeds/seed.ts",
    "db:studio": "bun --bun drizzle-kit studio",
    "gen:openapi": "bun run scripts/gen-openapi.ts",
    "gen:openapi:check": "bun run scripts/gen-openapi.ts --check",
    "mock": "bunx @stoplight/prism-cli@5.16.0 mock openapi.json -p 4010",
    "gen:apidocs": "bun run scripts/gen-api-docs.ts",
    "gen:apidocs:check": "bun run scripts/gen-api-docs.ts --check"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1160.0",
    "@aws-sdk/s3-request-presigner": "^3.1160.0",
    "@hono/zod-openapi": "1.6.3",
    "drizzle-orm": "^0.44.6",
    "hono": "^4.10.3",
    "pg": "^8.16.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.4",
    "@neon/config": "^1.9.6",
    "@neon/env": "^1.6.6",
    "@types/bun": "^1.3.2",
    "@types/pg": "^8.15.6",
    "drizzle-kit": "^0.31.6",
    "typescript": "^5.9.3"
  }
}
