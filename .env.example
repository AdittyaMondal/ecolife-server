# ecolife-server — Appendix B of PRD-v2.md. Names only; secrets stay empty.
# Every variable here is parsed by src/config/env.ts at boot.
# A missing required variable is a startup failure, never a silent fallback.

NODE_ENV=
PORT=4000

# ─── Postgres (Neon) ────────────────────────────────────────────────────────
# DATABASE_URL        = DIRECT endpoint  (no -pooler) — Drizzle migrations
# DATABASE_URL_POOLED = POOLED endpoint  (-pooler)    — all app traffic
#
# Do not paste these by hand. Each dev pulls their OWN branch:
#   neon env pull --project-id <project> --branch dev-<yourname>
# then rename what it writes to match the two names above.
DATABASE_URL=
DATABASE_URL_POOLED=

# ─── Auth (PRD-v2 §6.1) ─────────────────────────────────────────────────────
# JWT access token (15 min) + opaque refresh token (30 d, hashed at rest).
# Web keeps the refresh token in an httpOnly cookie; mobile in expo-secure-store.
JWT_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
SESSION_COOKIE_NAME=ecolife_refresh

# ─── Clients ────────────────────────────────────────────────────────────────
# Browser origin(s) allowed by CORS. Comma-separated for more than one:
#   APP_ORIGIN=https://app.example.com,http://localhost:3000
APP_ORIGIN=http://localhost:3000
MOBILE_SCHEME=ecolife

# This server's own public base URL, e.g. https://api.example.com. Used only so
# the /docs "try it" button calls the deployment instead of localhost:4000.
PUBLIC_API_URL=

# Shared secret letting ecolife-web assert the end user's IP via
# x-ecolife-client-ip. Without it the server uses the socket address and ignores
# x-forwarded-for, which is attacker-controlled. See CLAUDE.md §4.1.1.
INTERNAL_PROXY_TOKEN=
TRUSTED_PROXY_HOPS=0

# ─── Economy (PRD-v2 §4.3) ──────────────────────────────────────────────────
# Server-authoritative. Clients only ever preview a price.
COINS_PER_RUPEE=10
MAX_DISCOUNT_PCT=20

# ─── Object storage (Neon Object Storage, S3-compatible) ────────────────────
# Provisioned by `neon deploy` from neon.ts, which also writes these four into
# .env. Do NOT paste them by hand, and note that the same command rewrites
# DATABASE_URL using Neon's naming — see README "Neon CLI and .env".
#
# The bucket name is ours; the AWS_* names are what the S3 SDKs read from the
# environment automatically.
S3_BUCKET=uploads
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=

# ─── Mail ───────────────────────────────────────────────────────────────────
SMTP_URL=
MAIL_FROM=

# ─── Push (v2.1 — token registration ships, sender does not) ────────────────
EXPO_ACCESS_TOKEN=

# ─── API reference at /docs ─────────────────────────────────────────────────
# Always on outside production. In production set ENABLE_API_DOCS=true to
# serve it. Do NOT instead set NODE_ENV=development to get the docs page —
# that also drops `secure` from the refresh-token cookie, sending a 30-day
# credential over plain HTTP.
#
# Set API_DOCS_TOKEN (16+ chars) to require /docs?token=…, so the full API
# surface is not simply public. Without it the page is open to anyone.
ENABLE_API_DOCS=false
API_DOCS_TOKEN=

# ─── Observability ──────────────────────────────────────────────────────────
SENTRY_DSN=
