# ecolife-server — Appendix A of PRD.md. Names only; secrets stay empty.
# Every variable here is parsed by src/config/env.ts at boot.
# A missing required variable is a startup failure, never a silent fallback.

NODE_ENV=
PORT=4000

# Postgres (Neon). DATABASE_URL is the DIRECT endpoint — used by Drizzle
# migrations. DATABASE_URL_POOLED is the -pooler endpoint — used by app traffic.
DATABASE_URL=
DATABASE_URL_POOLED=

SESSION_COOKIE_NAME=ecolife_session
SESSION_TTL_DAYS=30
APP_ORIGIN=

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_DAILY_TOKEN_BUDGET=

S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

WHATSAPP_API_URL=
WHATSAPP_INSTANCE_ID=
WHATSAPP_ACCESS_TOKEN=
MERCHANT_NOTIFY_NUMBER=

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

AGENTHUB_URL=
AGENTHUB_KEY=
AGENTHUB_SIGNING_KEY=

ELECTRICITY_MAPS_TOKEN=
SENTRY_DSN=
